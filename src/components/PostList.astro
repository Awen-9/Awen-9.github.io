---
import { formatDate, postPath, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  brief?: boolean;
}
const { posts, brief = true } = Astro.props;
---

<ol class="lp-list">
  {
    posts.map((post) => (
      <li data-k={[post.data.category, ...post.data.tags].join(' ')}>
        <a href={postPath(post)} data-t={post.data.date.valueOf()}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span class="lp-cat">{post.data.category}</span>
          <span class="lp-t">{post.data.title}</span>
          {brief && post.data.description && <span class="lp-d">{post.data.description}</span>}
        </a>
      </li>
    ))
  }
</ol>
